FROM node:23-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

FROM base AS build
WORKDIR /app
COPY . /app

# Install required build dependencies
RUN corepack enable
RUN apk add --no-cache python3 alpine-sdk

# Install all dependencies (including dev dependencies for build)
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# Build arguments for web app configuration
ARG WEB_DEFAULT_API
ARG WEB_HOST
ARG WEB_PLAUSIBLE_HOST

# Set environment variables for build
ENV WEB_DEFAULT_API=${WEB_DEFAULT_API}
ENV WEB_HOST=${WEB_HOST}
ENV WEB_PLAUSIBLE_HOST=${WEB_PLAUSIBLE_HOST}

# Build the web application
RUN pnpm --filter=@imput/cobalt-web run build

FROM nginx:alpine AS web
WORKDIR /usr/share/nginx/html

# Copy built static files from build stage
COPY --from=build --chown=nginx:nginx /app/web/build /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Remove default nginx index page
RUN rm -f /usr/share/nginx/html/index.html

EXPOSE 3000

# Run nginx on port 3000
CMD ["nginx", "-g", "daemon off;"] 