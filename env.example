# Coolify 部署环境变量配置模板
# 复制此文件为 .env 并根据实际情况修改值

# =============================================================================
# Cobalt API 配置
# =============================================================================

# 必需: API服务的完整URL
API_URL=https://download.cohook.com

# 可选: API服务监听端口
API_PORT=9000

# CORS 配置
CORS_URL=https://cobalt.cohook.com
CORS_WILDCARD=0

# 速率限制配置
RATELIMIT_WINDOW=60
RATELIMIT_MAX=20

# 媒体持续时间限制 (秒)
DURATION_LIMIT=10800

# =============================================================================
# Cobalt Web 前端配置
# =============================================================================

# 必需: 前端连接的API URL
WEB_DEFAULT_API=https://download.cohook.com

# 必需: 前端域名
WEB_HOST=cobalt.cohook.com

# 可选: Plausible 分析服务
# WEB_PLAUSIBLE_HOST=plausible.cohook.com

# =============================================================================
# Coolify 特定配置
# =============================================================================

# Coolify 服务域名配置
SERVICE_FQDN_COBALT_API_9000=download.cohook.com
SERVICE_FQDN_COBALT_WEB_3000=cobalt.cohook.com

# =============================================================================
# 高级配置 (可选)
# =============================================================================

# 禁用特定服务 (逗号分隔)
# DISABLED_SERVICES=bilibili,youtube

# 外部代理
# API_EXTERNAL_PROXY=http://proxy.example.com:8080

# 处理优先级 (Unix系统)
# PROCESSING_PRIORITY=10

# Turnstile 验证码 (需要全部配置才能启用)
# TURNSTILE_SITEKEY=1x00000000000000000000BB
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# JWT_SECRET=your-very-long-random-secret-string-here

# YouTube 特定配置
# CUSTOM_INNERTUBE_CLIENT=WEB
# YOUTUBE_ALLOW_BETTER_AUDIO=1

# =============================================================================
# Docker Compose 覆盖变量
# =============================================================================

# 如果需要修改默认的镜像版本
# COBALT_API_IMAGE=wizdy/cobalt-api:latest

# 如果需要修改端口映射
# COBALT_API_PORT=9000
# COBALT_WEB_PORT=3000 